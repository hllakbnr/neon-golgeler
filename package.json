{
  "name": "neon-golgeler",
  "productName": "Neon Gölgeler",
  "version": "1.0.0",
  "description": "Three.js açık dünya hikayeli aksiyon-macera (blok oyuncak estetiği)",
  "main": "electron/main.js",
  "scripts": {
    "vendor": "node tools/fetch-vendor.mjs",
    "start": "electron .",
    "dist:win": "npm run vendor && electron-builder --win portable nsis",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.neongolgeler.game",
    "productName": "Neon Gölgeler",
    "files": ["electron/**"],
    "extraResources": [{ "from": "game", "to": "game" }],
    "win": { "target": ["portable", "nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
