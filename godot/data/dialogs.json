 "_dj": [
  {
   "id": "dj_neonfm_1",
   "who": "dj_m",
   "text": "Neon FM, gecenin sesi. Gaza bas, şehir ışıkları seninle."
  },
  {
   "id": "dj_neonfm_2",
   "who": "dj_m",
   "text": "Burası Neon FM. Neon Bulvar'dan selamlar, sıradaki parça geliyor."
  },
  {
   "id": "dj_ritim_1",
   "who": "dj_m",
   "text": "Ritim doksan üç! Kafa sallamaya hazır mısın?"
  },
  {
   "id": "dj_ritim_2",
   "who": "dj_m",
   "text": "Ritim doksan üçte sakin bir akşam. Bas ritmi, keyfine bak."
  },
  {
   "id": "dj_kanyon_1",
   "who": "dj_m",
   "text": "Kızıl Kanyon Rock! Sesi aç, camları indir!"
  },
  {
   "id": "dj_kanyon_2",
   "who": "dj_m",
   "text": "Rock asla ölmez. Kızıl Kanyon'dan herkese selam!"
  },
  {
   "id": "dj_sakura_1",
   "who": "dj_k",
   "text": "Sakura Radyo. Huzurlu bir yolculuk dileriz."
  },
  {
   "id": "dj_sakura_2",
   "who": "dj_k",
   "text": "Kiraz çiçeklerinin sesi, Sakura Radyo."
  },
  {
   "id": "dj_cay_1",
   "who": "dj_k",
   "text": "Çay Ocağı FM. Çayınız demli, yolunuz açık olsun."
  },
  {
   "id": "dj_cay_2",
   "who": "dj_k",
   "text": "Buyurun efendim, Çay Ocağı FM'desiniz."
  },
  {
   "id": "dj_dalga_1",
   "who": "dj_k",
   "text": "Gece Dalgası. Derin bir nefes al, yol uzun."
  },
  {
   "id": "dj_dalga_2",
   "who": "dj_k",
   "text": "Gece Dalgası ile sakin kal, şehir seninle."
  }
 ],
 "intro_story": [
  {
   "id": "intro_story_1",
   "who": "usta",
   "text": "Bu kıtada dört element, yüzyıllar boyunca dengede durdu."
  },
  {
   "id": "intro_story_2",
   "who": "usta",
   "text": "Kasırga Manastırı'nın ustaları bu dengeyi koruyacak ninjaları yetiştirdi."
  },
  {
   "id": "intro_story_3",
   "who": "usta",
   "text": "Ama Neon Şehir büyüdükçe, ışıklarının altındaki gölgeler de büyüdü."
  },
  {
   "id": "intro_story_4",
   "who": "usta",
   "text": "Şimdi sokaklarda adı bilinmeyen bir çete, elementlerin gücünü ele geçirmenin yolunu arıyor."
  },
  {
   "id": "intro_story_5",
   "who": "kaan",
   "text": "Ben Kaan Demir. Metal elementinin ustasıyım. Ve uzun bir aradan sonra, eve döndüm."
  }
 ]
